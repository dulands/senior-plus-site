---
import { eventNames } from '../lib/events';
import { buildWhatsAppUrl } from '../lib/whatsapp';
import Button from './Button.astro';
import Icon from './Icon.astro';
---

<section class="section final-cta" aria-labelledby="final-cta-title">
  <div class="container final-cta__inner">
    <div class="final-cta__icon"><Icon name="heart" size={72} strokeWidth={1.7} /></div>
    <h2 id="final-cta-title">Pronto para começar?</h2>
    <p>Entre em contato hoje e descubra como podemos cuidar de quem você mais ama</p>
    <div class="final-cta__actions">
      <Button
        href={buildWhatsAppUrl('seniorPlus', 'evaluation')}
        variant="light"
        size="large"
        target="_blank"
        rel="noopener noreferrer"
        dataEvent={eventNames.whatsappSeniorPlusClick}
        dataContact="senior-plus"
        dataLocation="final_cta"
        dataCta="falar_senior_plus"
      >
        <Icon name="phone" size={19} /> WhatsApp Sênior Plus
      </Button>
    </div>
  </div>
</section>
