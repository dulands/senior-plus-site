---
import { eventNames } from '../lib/events';
import { buildWhatsAppUrl } from '../lib/whatsapp';
import BrandIcon from './BrandIcon.astro';
---

<a
  class="floating-whatsapp"
  href={buildWhatsAppUrl('annie', 'general')}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Conversar com Annie Uno pelo WhatsApp"
  data-event={eventNames.whatsappAnnieClick}
  data-contact="annie"
  data-location="floating-button"
  data-cta="whatsapp"
>
  <BrandIcon name="whatsapp" size={32} />
</a>
