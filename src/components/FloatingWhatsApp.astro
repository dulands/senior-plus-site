---
import { eventNames } from '../lib/events';
import { buildWhatsAppUrl } from '../lib/whatsapp';
import BrandIcon from './BrandIcon.astro';
---

<a
  class="floating-whatsapp"
  href={buildWhatsAppUrl('seniorPlus', 'general')}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Conversar com a Sênior Plus pelo WhatsApp"
  data-event={eventNames.whatsappSeniorPlusClick}
  data-contact="senior-plus"
  data-location="floating-button"
  data-cta="whatsapp"
>
  <BrandIcon name="whatsapp" size={32} />
</a>

<script>
  const initializeFloatingWhatsApp = () => {
    const button = document.querySelector<HTMLElement>('.floating-whatsapp');
    const form = document.querySelector<HTMLElement>('[data-contact-form]');
    if (!button || !form || button.dataset.overlapReady === 'true') return;
    button.dataset.overlapReady = 'true';

    const observer = new IntersectionObserver(([entry]) => {
      button.dataset.formOverlap = String(Boolean(entry?.isIntersecting));
    }, { threshold: 0.08 });
    observer.observe(form);
  };

  initializeFloatingWhatsApp();
  document.addEventListener('astro:page-load', initializeFloatingWhatsApp);
</script>
