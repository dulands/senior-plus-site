---
import {
  ArrowRight,
  Award,
  BadgeCheck,
  BriefcaseBusiness,
  CalendarDays,
  Camera,
  Check,
  ClipboardCheck,
  Clock3,
  Heart,
  HandHeart,
  HeartHandshake,
  Handshake,
  Globe,
  MapPin,
  Mail,
  Menu,
  MessageCircle,
  Moon,
  Phone,
  Plane,
  Quote,
  Search,
  Send,
  ShieldCheck,
  Shield,
  Smile,
  Sparkles,
  Star,
  Stethoscope,
  Sun,
  Target,
  ThumbsUp,
  TrendingUp,
  Trophy,
  UserCheck,
  Users,
  Lightbulb,
  X,
} from '@lucide/astro';
import type { IconName } from '../types/site';

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
  decorative?: boolean;
  label?: string;
}

const {
  name,
  size = 24,
  strokeWidth = 2,
  class: className,
  decorative = true,
  label,
} = Astro.props;

const icons = {
  'arrow-right': ArrowRight,
  award: Award,
  'badge-check': BadgeCheck,
  briefcase: BriefcaseBusiness,
  calendar: CalendarDays,
  check: Check,
  'clipboard-check': ClipboardCheck,
  clock: Clock3,
  heart: Heart,
  'hand-heart': HandHeart,
  handshake: Handshake,
  'home-heart': HeartHandshake,
  globe: Globe,
  instagram: Camera,
  'map-pin': MapPin,
  mail: Mail,
  menu: Menu,
  'message-circle': MessageCircle,
  moon: Moon,
  phone: Phone,
  plane: Plane,
  quote: Quote,
  search: Search,
  send: Send,
  'shield-check': ShieldCheck,
  shield: Shield,
  smile: Smile,
  sparkles: Sparkles,
  star: Star,
  stethoscope: Stethoscope,
  sun: Sun,
  target: Target,
  'thumbs-up': ThumbsUp,
  'trending-up': TrendingUp,
  trophy: Trophy,
  'user-check': UserCheck,
  users: Users,
  lightbulb: Lightbulb,
  x: X,
} as const;

const IconComponent = icons[name];
const iconAttributes = {
  ...(className ? { class: className } : {}),
  ...(decorative
    ? { 'aria-hidden': 'true' as const }
    : label
      ? { 'aria-label': label }
      : {}),
};
---

<IconComponent
  size={size}
  stroke-width={strokeWidth}
  focusable="false"
  {...iconAttributes}
/>
