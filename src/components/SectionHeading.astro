---
import SectionEyebrow from './SectionEyebrow.astro';

interface Props {
  kicker?: string;
  title: string;
  description?: string;
  id?: string;
  centered?: boolean;
}

const { kicker, title, description, id, centered = true } = Astro.props;
---

<div class:list={['section-heading', centered && 'section-heading--center']}>
  {kicker && <SectionEyebrow text={kicker} />}
  <h2 id={id}>{title}</h2>
  {description && <p>{description}</p>}
</div>
