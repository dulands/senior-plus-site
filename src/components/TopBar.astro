---
import { brand, contacts } from '../data/site';
import { eventNames } from '../lib/events';
import { buildWhatsAppUrl } from '../lib/whatsapp';
import BrandIcon from './BrandIcon.astro';
import Icon from './Icon.astro';
---

<div class="top-bar">
  <div class="container top-bar__inner">
    <div class="top-bar__group">
      <span class="top-bar__item">
        <Icon name="map-pin" size={15} />
        {brand.location}
      </span>
      <span class="top-bar__item top-bar__availability">
        <Icon name="clock" size={15} />
        Disponível 24/7
      </span>
    </div>
    <div class="top-bar__group top-bar__contacts" aria-label="Contatos pelo WhatsApp">
      <a
        href={buildWhatsAppUrl('annie', 'annie')}
        target="_blank"
        rel="noopener noreferrer"
        data-event={eventNames.whatsappAnnieClick}
        data-contact="annie"
        data-location="top_bar"
      >
        <BrandIcon name="whatsapp" size={15} />
        Annie: {contacts.annie.phoneDisplay}
      </a>
      <a
        href={buildWhatsAppUrl('fabiano', 'fabiano')}
        target="_blank"
        rel="noopener noreferrer"
        data-event={eventNames.whatsappFabianoClick}
        data-contact="fabiano"
        data-location="top_bar"
      >
        <BrandIcon name="whatsapp" size={15} />
        Fabiano: {contacts.fabiano.phoneDisplay}
      </a>
    </div>
  </div>
</div>
