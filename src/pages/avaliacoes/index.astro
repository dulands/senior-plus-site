---
import Icon from '../../components/Icon.astro';
import InternalHero from '../../components/InternalHero.astro';
import PageCTA from '../../components/PageCTA.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Stars from '../../components/Stars.astro';
import { metrics, pageMetadata, testimonials } from '../../data/site';
import { eventNames } from '../../lib/events';
import { buildWhatsAppUrl } from '../../lib/whatsapp';
import BaseLayout from '../../layouts/BaseLayout.astro';

const meta = pageMetadata.reviews;
const structuredData = { '@context': 'https://schema.org', '@type': 'WebPage', name: meta.title, description: meta.description, inLanguage: 'pt-BR' };
---

<BaseLayout title={meta.title} description={meta.description} image="/images/og-senior-plus.jpg" structuredData={structuredData}>
  <InternalHero icon="star" title="Avaliações" lead="O que as famílias que confiam na Sênior Plus têm a dizer sobre nosso trabalho em São Paulo - SP" />

  <section class="section page-section metrics-section" aria-label="Indicadores confirmados">
    <div class="container metrics-grid">
      {metrics.map((metric) => (
        <article class="metric-card">
          {metric.value === '5.0' && <Stars />}
          <strong>{metric.value}</strong><span>{metric.label}</span>
        </article>
      ))}
    </div>
  </section>

  <section class="section page-section page-section--soft" aria-labelledby="depoimentos-title">
    <div class="container">
      <SectionHeading id="depoimentos-title" kicker="Depoimentos" title="Histórias de Cuidado e Confiança" description="Veja o que nossos clientes e suas famílias dizem sobre nós" />
      <div class="reviews-grid">
        {testimonials.map((testimonial) => (
          <article class="review-card">
            <div class="review-card__top"><Stars /><Icon name="quote" size={30} /></div>
            <blockquote>“{testimonial.quote}”</blockquote>
            <footer>
              <strong>{testimonial.name}</strong>
              <span>{testimonial.relationship}</span>
              <small><Icon name="map-pin" size={15} /> {testimonial.neighborhood}</small>
            </footer>
          </article>
        ))}
      </div>
    </div>
  </section>

  <PageCTA title="Faça parte desta história" description="Venha conhecer o cuidado que transforma vidas em São Paulo - SP" label="Solicitar Avaliação" href={buildWhatsAppUrl('annie', 'evaluation')} event={eventNames.whatsappAnnieClick} contact="annie" location="reviews" />
</BaseLayout>
