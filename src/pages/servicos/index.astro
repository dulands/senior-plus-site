---
import { Image } from 'astro:assets';
import communicationImage from '../../assets/images/internal-care.jpg';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import InternalHero from '../../components/InternalHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { integratedCommunication, selectionSteps } from '../../data/pages';
import { pageMetadata, services } from '../../data/site';
import { eventNames } from '../../lib/events';
import { buildWhatsAppUrl } from '../../lib/whatsapp';
import BaseLayout from '../../layouts/BaseLayout.astro';

const meta = pageMetadata.services;
const structuredData = { '@context': 'https://schema.org', '@type': 'WebPage', name: meta.title, description: meta.description, inLanguage: 'pt-BR' };
---

<BaseLayout title={meta.title} description={meta.description} image="/images/og-senior-plus.jpg" structuredData={structuredData}>
  <InternalHero title="Nossos Serviços" lead="Cuidado completo e humanizado para idosos em São Paulo - SP, com profissionais qualificados e planos sob medida" />

  <section class="section page-section page-section--soft" aria-labelledby="oferecemos-title">
    <div class="container">
      <SectionHeading id="oferecemos-title" kicker="Serviços Principais" title="O que oferecemos" description="Soluções completas para cada necessidade de cuidado" />
      <div class="service-detail-grid">
        {services.map((service) => (
          <article class="service-detail-card">
            <span class="card-icon"><Icon name={service.icon} size={31} /></span>
            <h3>{service.title}</h3>
            <strong>{service.subtitle}</strong>
            <p>{service.description}</p>
            <ul class="compact-check-list">
              {service.items?.map((item) => <li><Icon name="check" size={17} /> {item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section page-section" aria-labelledby="selecao-title">
    <div class="container">
      <SectionHeading id="selecao-title" kicker="Nosso Processo" title="Seleção Rigorosa de Cuidadores" description="6 etapas criteriosamente executadas para garantir profissionais excepcionais" />
      <ol class="process-grid">
        {selectionSteps.map((step, index) => (
          <li>
            <span>{index + 1}</span>
            <div><h3>{step.title}</h3><p>{step.description}</p></div>
          </li>
        ))}
      </ol>
      <article class="quality-card">
        <span class="card-icon"><Icon name="shield-check" size={32} /></span>
        <div>
          <h3>Garantia de Qualidade</h3>
          <p>Todo profissional da Sênior Plus passa por este processo criterioso antes de iniciar o atendimento. Além disso, realizamos treinamentos contínuos e avaliações periódicas para manter o mais alto padrão de qualidade no cuidado aos nossos clientes em São Paulo - SP.</p>
        </div>
      </article>
    </div>
  </section>

  <section class="section page-section page-section--soft" aria-labelledby="comunicacao-title">
    <div class="container media-section">
      <div class="media-section__image">
        <Image src={communicationImage} alt="Profissional de saúde em comunicação integrada" widths={[560, 800, 1200]} sizes="(max-width: 900px) 100vw, 50vw" format="webp" quality={82} loading="lazy" />
      </div>
      <div>
        <span class="section-kicker">Diferencial Sênior+</span>
        <h2 id="comunicacao-title">Comunicação Integrada</h2>
        <p>Criamos grupos de WhatsApp exclusivos incluindo a família, equipe de cuidadores e nossa enfermeira coordenadora.</p>
        <ul class="compact-check-list compact-check-list--large">
          {integratedCommunication.map((item) => <li><Icon name="check" size={18} /> {item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="page-cta" aria-labelledby="servicos-cta-title">
    <div class="container page-cta__inner">
      <h2 id="servicos-cta-title">Precisa de mais informações?</h2>
      <p>Entre em contato e saiba qual plano é ideal para suas necessidades</p>
      <div class="page-cta__actions">
        <Button href={buildWhatsAppUrl('annie', 'services')} variant="light" size="large" target="_blank" rel="noopener noreferrer" dataEvent={eventNames.whatsappAnnieClick} dataContact="annie" dataLocation="services-cta">Falar com Annie</Button>
        <Button href={buildWhatsAppUrl('fabiano', 'services')} variant="light" size="large" target="_blank" rel="noopener noreferrer" dataEvent={eventNames.whatsappFabianoClick} dataContact="fabiano" dataLocation="services-cta">Falar com Fabiano</Button>
      </div>
    </div>
  </section>
</BaseLayout>
